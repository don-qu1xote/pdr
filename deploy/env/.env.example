# Образец окружения ПДР: полный список переменных и откуда взять каждую.
#
# ЭТО ДОКУМЕНТАЦИЯ ПО ЗАПУСКУ. Значений здесь нет и не будет: образец со
# значением однажды скопируют целиком, и «change-me» доживёт до прода. Пустое
# значение роняет подъём сразу — compose объявлен так, что переменной без
# значения не бывает.
#
# Профилем этот файл не является. Профили — deploy/env/<профиль>.env.example, и
# каждый обязан задать РОВНО этот список: разъезд ловит
# scripts/verify_env_parity.py.
#
# Как поднять установку — deploy/README.md. Коротко:
#     cp deploy/env/local.env.example deploy/env/local.env
#     cp deploy/secrets/secrets.json.example deploy/secrets/secrets.json
#     chmod 600 deploy/secrets/secrets.json
#     make up

# Имя профиля. Совпадает с именем файла: из него собирается имя проекта в
# docker, поэтому local и ci стоят на одной машине одновременно.
ENV_PROFILE=

# Пределы по умолчанию для любого контейнера. Взять: столько, сколько не жалко
# на вашей машине; сервис, которому нужно иначе, переопределяет их явно.
DEFAULT_MEM_LIMIT=
DEFAULT_CPU_LIMIT=

# Логи: предел на файл и число файлов. Взять: одинаковые во всех профилях —
# разъезд означал бы «на машине не воспроизводится» из-за ротации.
LOG_MAX_SIZE=
LOG_MAX_FILES=

# Хранилище. Образ и имена — те же, что в остальных профилях, иначе «у меня
# работает» перестаёт что-либо значить. Взять: postgres:16, pdr, pdr.
POSTGRES_IMAGE=
POSTGRES_MEM_LIMIT=
POSTGRES_USER=
POSTGRES_DB=

# Пароль роли базы. Взять: придумать у себя. Это НЕ секрет приложения: сервис
# читает строку подключения из файла секретов, а не отсюда. Здесь он нужен
# контейнеру Postgres, чтобы завести роль при первом подъёме.
POSTGRES_PASSWORD=

# Порт базы на хосте. Взять: любой свободный; 5432 занят чужим процессом чаще,
# чем хотелось бы.
POSTGRES_PORT=

# Путь к файлу секретов. ОКРУЖЕНИЕ НЕСЁТ ПУТЬ, А НЕ ЗНАЧЕНИЯ: переменные видны в
# /proc, попадают в дампы процесса и в отчёты об ошибках, а файл с правами 0600
# — нет. Взять: ./deploy/secrets/secrets.json, сам файл — из
# deploy/secrets/secrets.json.example. Что в нём обязано лежать —
# configs/secrets_registry.yaml.
PDR_SECDIST_PATH=

# Применять ли миграции при подъёме. Взять: 1 локально; 0 означает «применит
# кто-то другой» — старт всё равно сверит контрольные суммы.
MIGRATE_ON_START=

# Заглушка инференса: контейнер, который честно говорит, что он заглушка.
# Взять: alpine:3.20. Настоящий образ подставит PDR-NOTES-02 — сменой
# переменной, а не файла.
ML_IMAGE=
ML_MEM_LIMIT=

# Первый процесс. Образ собирается из дерева (deploy/Dockerfile). Взять: любое
# имя с тегом профиля; порт — свободный на вашей машине. Служебный слушатель
# наружу не выводится вовсе.
SCHEDULING_IMAGE=
SCHEDULING_MEM_LIMIT=
SCHEDULING_PORT=
