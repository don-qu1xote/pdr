# Профиль ci — тот же состав сервисов, что и в local, теми же образами.
#
# Отличаться профилям разрешено ровно тремя переменными, и этот список записан
# в scripts/verify_env_parity.py. Всё остальное обязано совпасть — иначе «в CI
# зелено, а на машине падает» становится нормой.
#
# Скопируйте рядом под настоящим именем:
#     cp deploy/env/ci.env.example deploy/env/ci.env
#
# Настоящие deploy/env/*.env в историю не попадают (см. .gitignore). Значений по
# умолчанию у переменных нет: пропущенная переменная роняет конфигурацию сразу,
# а не через час работы.

# Имя профиля. Должно совпадать с именем файла.
ENV_PROFILE=ci

# Пределы по умолчанию для любого контейнера. Сервис, которому нужно иначе,
# переопределяет их явно и с причиной.
DEFAULT_MEM_LIMIT=256m
DEFAULT_CPU_LIMIT=1.0

# Логи: предел на файл и число файлов. Одинаковы во всех профилях — разъезд
# здесь означал бы, что «на машине не воспроизводится» из-за ротации.
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3

# Хранилище. Образ и имена — те же, что в остальных профилях: иначе «у меня
# работает» перестаёт что-либо значить.
POSTGRES_IMAGE=postgres:16
POSTGRES_MEM_LIMIT=512m
POSTGRES_USER=pdr
POSTGRES_DB=pdr
# База в CI живёт минуты и никуда не смотрит наружу. Настоящих секретов в
# примерах нет ни в одном профиле.
POSTGRES_PASSWORD=ci-not-a-secret
# Порт другой: на раннере может оказаться чужой Postgres, и спорить с ним
# незачем.
POSTGRES_PORT=55432

# Применять ли миграции при подъёме установки. Ноль означает «применит кто-то
# другой»: старт всё равно сверит контрольные суммы и откажется работать со
# схемой, отставшей от файлов.
MIGRATE_ON_START=1

# Заглушка инференса: контейнер, который честно говорит, что он заглушка.
# Настоящий образ подставит PDR-NOTES-02 — сменой переменной, а не файла.
ML_IMAGE=alpine:3.20
ML_MEM_LIMIT=256m
