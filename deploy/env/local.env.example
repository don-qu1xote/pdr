# Профиль local — рабочая установка на машине разработчика.
#
# Скопируйте рядом под настоящим именем и поменяйте пароль:
#     cp deploy/env/local.env.example deploy/env/local.env
#
# Настоящие deploy/env/*.env в историю не попадают (см. .gitignore). Значений по
# умолчанию у переменных нет: пропущенная переменная роняет конфигурацию сразу,
# а не через час работы.

# Имя профиля. Должно совпадать с именем файла: из него собирается имя проекта
# в docker, поэтому local и ci могут стоять на одной машине одновременно.
ENV_PROFILE=local

# Пределы по умолчанию для любого контейнера. Сервис, которому нужно иначе,
# переопределяет их явно и с причиной.
DEFAULT_MEM_LIMIT=256m
DEFAULT_CPU_LIMIT=1.0

# Логи: предел на файл и число файлов. Одинаковы во всех профилях — разъезд
# здесь означал бы, что «на машине не воспроизводится» из-за ротации.
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3

# Хранилище. Образ и имена — те же, что в остальных профилях: иначе «у меня
# работает» перестаёт что-либо значить.
POSTGRES_IMAGE=postgres:16
POSTGRES_MEM_LIMIT=512m
POSTGRES_USER=pdr
POSTGRES_DB=pdr
# Пароль локальной базы. Не секрет и не значение по умолчанию: строка, которую
# вы меняете у себя. Настоящие секреты в примерах не живут.
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432

# Секреты. Окружение несёт ПУТЬ к файлу, а не значения: переменные видны в /proc,
# попадают в дампы процесса и в отчёты об ошибках, а файл с правами 0600 — нет.
# Сам файл в историю не попадает; образец — deploy/secrets/secrets.json.example.
# Сервиса пока нет, поэтому переменную никто не читает: она заведена вместе с
# форматом файла, чтобы первый сервис не изобретал её заново.
PDR_SECDIST_PATH=./deploy/secrets/secrets.json

# Применять ли миграции при подъёме установки. Ноль означает «применит кто-то
# другой»: старт всё равно сверит контрольные суммы и откажется работать со
# схемой, отставшей от файлов.
MIGRATE_ON_START=1

# Заглушка инференса: контейнер, который честно говорит, что он заглушка.
# Настоящий образ подставит PDR-NOTES-02 — сменой переменной, а не файла.
ML_IMAGE=alpine:3.20
ML_MEM_LIMIT=256m

# Первый процесс. Образ собирается из дерева (deploy/Dockerfile), имя нужно
# затем, чтобы пересборка не плодила безымянных слоёв.
SCHEDULING_IMAGE=pdr/scheduling:local
SCHEDULING_MEM_LIMIT=512m
# Клиентский порт наружу. Служебный слушатель не публикуется вовсе.
SCHEDULING_PORT=8080
