# Пробелы, переносы и кодировка — здесь. Форматирование C++ — в .clang-format.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Согласовано с .clang-format: IndentWidth 4, ColumnLimit 100
[*.{c,h,cc,cpp,cxx,hpp,hxx,ipp}]
indent_size = 4
max_line_length = 100

[{CMakeLists.txt,*.cmake}]
indent_size = 4

[*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css,scss,html}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.py]
indent_size = 4

[*.sql]
indent_size = 4

# Два пробела в конце строки — это перенос, а не мусор
[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
