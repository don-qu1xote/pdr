# Секреты и локальные настройки: значений по умолчанию не существует
.env
.env.*
*.pem
*.key
secrets/
# Файл секретов сервиса: сам не в истории, пример рядом — в истории. Каталог
# приходится разисключить целиком: git не заходит внутрь исключённого каталога,
# и одного «!*.example» не хватило бы. Права 0600 на настоящем файле проверяет
# scripts/check_secrets.py.
!/deploy/secrets/
/deploy/secrets/*
!/deploy/secrets/*.example
# Настоящие значения профилей окружения. Примеры рядом (*.env.example) лежат в
# истории и служат образцом; сами значения — нет.
/deploy/env/*.env
!/deploy/env/*.env.example

