#!/bin/sh
# Хук pre-commit: формат кода и версия форматтера — до коммита, а не после
# красного CI.
#
# Хук зовёт ТУ ЖЕ цель Makefile, что и джоба lint в .github/workflows/ci.yml.
# Не похожую команду, а буквально одну и ту же: две команды расходятся молча —
# сначала списком файлов, потом набором ключей, и виноватым оказывается CI.
#
# Цель проверяет версию форматтера, а не его наличие: clang-format не
# байт-стабилен между версиями, и разработчик с другой версией отформатирует
# «чисто», а CI покраснеет. Версия закреплена в .clang-format-version.
#
# Ставится один раз: make hooks (git config core.hooksPath githooks).
# Обойти в исключительном случае: git commit --no-verify.
#
# Проверяется рабочее дерево, а не индекс. Так честнее для одной цели на хук и
# на CI: CI видит именно дерево. Частично проиндексированная правка это заметит.
set -eu

exec make --no-print-directory fmt-check
