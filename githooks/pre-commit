#!/bin/sh
# Хук pre-commit: формат, версия форматтера и комментарии — до коммита, а не
# после красного CI.
#
# Хук зовёт ТЕ ЖЕ цели Makefile, что и джобы lint и comments в
# .github/workflows/ci.yml. Не похожие команды, а буквально те же самые: две
# команды расходятся молча — сначала списком файлов, потом набором ключей, и
# виноватым оказывается CI.
#
# fmt-check проверяет версию форматтера, а не его наличие: clang-format не
# байт-стабилен между версиями, и разработчик с другой версией отформатирует
# «чисто», а CI покраснеет. Версия закреплена в .clang-format-version.
#
# comments проверяет политику комментариев (docs/comments.md): в коде остаётся
# только то, без чего не соберётся или не проверится сборка. Снять нарушения —
# make comments-fix.
#
# Ставится один раз: make hooks (git config core.hooksPath githooks).
# Обойти в исключительном случае: git commit --no-verify.
#
# Проверяется рабочее дерево, а не индекс. Так честнее для одних целей на хук и
# на CI: CI видит именно дерево. Частично проиндексированная правка это заметит.
set -eu

make --no-print-directory fmt-check
exec make --no-print-directory comments
