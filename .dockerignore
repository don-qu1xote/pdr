# В контекст сборки образа попадает только то, из чего собирается артефакт.
# Всё остальное — лишние мегабайты и лишние инвалидации кэша слоёв.

.git
.gitignore
.gitattributes
.github
.editorconfig
.dockerignore

build/
build-*/
cmake-build-*/
out/
_deps/
