{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["student_id", "starts_at", "minutes"],
  "properties": {
    "student_id": {
      "type": "string",
      "minLength": 1
    },
    "starts_at": {
      "type": "string",
      "minLength": 1
    },
    "minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 480
    }
  }
}
